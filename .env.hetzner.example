# Trap House Production Environment (Hetzner)
# Copy to .env.hetzner and adjust values for your VPS.

# Production ports: real ports on the VPS.
# Host SSH stays on port 22; the Endlessh tarpit listens on 22222. Cowrie and
# the deception web app take the ports attackers expect (2222/2223 and 80).
ENDLESSH_PORT=22222
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
DECEPTION_PORT=80
GRAFANA_PORT=3000
FRONTEND_PORT=8001

# Canarytokens (disabled by default, enable when ready)
ENABLE_CANARYTOKENS=false
# CANARYTOKEN_URL=https://canarytokens.org/...

# Trust X-Forwarded-For only behind a known reverse proxy. deception-gw is bound
# directly to port 80 here, so leave this false or source IPs can be spoofed.
TRUST_XFF=false

# Domain for canary email addresses seeded into the fake user data. Leave blank
# to disable. Never use canarytokens.org: point this at a canary domain you own.
CANARY_EMAIL_DOMAIN=

# Session secret for deception-gw. CHANGE THIS to a random string.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# Grafana admin password. CHANGE THIS.
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Log retention (days)
LOG_RETENTION_DAYS=90
DB_RETENTION_DAYS=180

# Docker GID for log-shipper (match host: getent group docker | cut -d: -f3)
DOCKER_GID=999