# Trap House Environment Configuration
# Copy to .env and adjust as needed

# Ports (local dev uses high ports to avoid host conflicts)
ENDLESSH_PORT=22222
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
DECEPTION_PORT=8080
GRAFANA_PORT=3000
FRONTEND_PORT=8001

# Production ports (use .env.hetzner for production)
# ENDLESSH_PORT=22
# DECEPTION_PORT=80

# Canary domain decoys. The current implementation logs locally and does not
# call an external canary service.
ENABLE_CANARYTOKENS=false

# Trust X-Forwarded-For only behind a known reverse proxy (false for direct exposure).
TRUST_XFF=false

# Domain for decoy email addresses in the fake user data. Blank disables them.
# Use a domain you control if you want outbound use to be observable.
CANARY_EMAIL_DOMAIN=

# Session secret for deception-gw signed cookies
SESSION_SECRET=local-development-only-session-secret

# Log retention (days)
LOG_RETENTION_DAYS=90
DB_RETENTION_DAYS=180

# Grafana
GRAFANA_ADMIN_PASSWORD=local-development-only-grafana-password

# Docker GID for log-shipper (match host: getent group docker | cut -d: -f3)
# Default 999 works for most Debian/Ubuntu hosts
DOCKER_GID=999