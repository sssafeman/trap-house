# Trap House Environment Configuration
# Copy to .env and adjust as needed

# Ports (local dev uses high ports to avoid host conflicts)
ENDLESSH_PORT=22222
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
DECEPTION_PORT=8080
GRAFANA_PORT=3000
FRONTEND_PORT=8001

# Production ports (use .env.hetzner for production)
# ENDLESSH_PORT=22
# DECEPTION_PORT=80

# Canarytokens
ENABLE_CANARYTOKENS=false
# CANARYTOKEN_URL=https://canarytokens.org/...

# Trust X-Forwarded-For only behind a known reverse proxy (false for direct exposure).
TRUST_XFF=false

# Domain for canary email addresses in the fake user data. Blank disables them.
# Never use canarytokens.org here: it fingerprints the app as a honeypot.
CANARY_EMAIL_DOMAIN=

# Session secret for deception-gw signed cookies
SESSION_SECRET=changeme-secret-key

# Log retention (days)
LOG_RETENTION_DAYS=90
DB_RETENTION_DAYS=180

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme

# Docker GID for log-shipper (match host: getent group docker | cut -d: -f3)
# Default 999 works for most Debian/Ubuntu hosts
DOCKER_GID=999